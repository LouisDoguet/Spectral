#!/bin/bash
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --gres=gpu:1
#SBATCH --mem=16GB
#SBATCH --time=6:00:00
#SBATCH --job-name=NNcomp
#SBATCH --array=0
#SBATCH --partition=gpu
#SBATCH --output=SlurmOutput/compare_%j_%a.txt
#SBATCH --account=aero_research_cantwell

module load cuda

source .venv_spectral/bin/activate

MOD_PATH="nn/training/checkpoints"
COMPARE_PATH="nn/evaluation/compare.py"
SUBNAME=("_AlphaNetO6_OPNO_C16")
POLY=(6)
MOD_BEST="alpha_model_best.eqx"
OUT_DIR="nn/evaluation/comp${SUBNAME[$SLURM_ARRAY_TASK_ID]}"

MOD="${MOD_PATH}${SUBNAME[$SLURM_ARRAY_TASK_ID]}/${MOD_BEST}"

echo "MODEL - ${MOD}"

python3 ${COMPARE_PATH} --model ${MOD} --case sod               --outdir "${OUT_DIR}_N32" --P ${POLY[${SLURM_ARRAY_TASK_ID}]} --n-elem 32
python3 ${COMPARE_PATH} --model ${MOD} --case lax               --outdir "${OUT_DIR}_N32" --P ${POLY[${SLURM_ARRAY_TASK_ID}]} --n-elem 32
python3 ${COMPARE_PATH} --model ${MOD} --case shu-osher         --outdir "${OUT_DIR}_N32" --P ${POLY[${SLURM_ARRAY_TASK_ID}]} --n-elem 32
python3 ${COMPARE_PATH} --model ${MOD} --case random --seed 42  --outdir "${OUT_DIR}_N32" --P ${POLY[${SLURM_ARRAY_TASK_ID}]} --n-elem 32

python3 ${COMPARE_PATH} --model ${MOD} --case sod               --outdir "${OUT_DIR}_N64" --P ${POLY[${SLURM_ARRAY_TASK_ID}]} --n-elem 64
python3 ${COMPARE_PATH} --model ${MOD} --case lax               --outdir "${OUT_DIR}_N64" --P ${POLY[${SLURM_ARRAY_TASK_ID}]} --n-elem 64
python3 ${COMPARE_PATH} --model ${MOD} --case shu-osher         --outdir "${OUT_DIR}_N64" --P ${POLY[${SLURM_ARRAY_TASK_ID}]} --n-elem 64
python3 ${COMPARE_PATH} --model ${MOD} --case random --seed 42  --outdir "${OUT_DIR}_N64" --P ${POLY[${SLURM_ARRAY_TASK_ID}]} --n-elem 64

python3 ${COMPARE_PATH} --model ${MOD} --case sod               --outdir "${OUT_DIR}_N128" --P ${POLY[${SLURM_ARRAY_TASK_ID}]} --n-elem 128
python3 ${COMPARE_PATH} --model ${MOD} --case lax               --outdir "${OUT_DIR}_N128" --P ${POLY[${SLURM_ARRAY_TASK_ID}]} --n-elem 128
python3 ${COMPARE_PATH} --model ${MOD} --case shu-osher         --outdir "${OUT_DIR}_N128" --P ${POLY[${SLURM_ARRAY_TASK_ID}]} --n-elem 128
python3 ${COMPARE_PATH} --model ${MOD} --case random --seed 42  --outdir "${OUT_DIR}_N128" --P ${POLY[${SLURM_ARRAY_TASK_ID}]} --n-elem 128
