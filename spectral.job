#!/bin/bash
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --mem=10GB
#SBATCH --time=5:59:00
#SBATCH --job-name=S1D
#SBATCH --partition=short
#SBATCH --output=SlurmOutput/Spectral1D.txt
#SBATCH --account=aero_hpc


./build/spectral \
    --P 6 --N 50 --T 0.2 --dt 5e-5 \
    --sensor --trunc 1 --s0 -3.0 --kappa 1 --eps0 5e-3 \
    --Q 30 --output PP_test/k1/SOD_P6_E50