#!/bin/bash
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --mem=16GB
#SBATCH --time=4:00:00
#SBATCH --job-name=RefData1D
#SBATCH --partition=short
#SBATCH --account=aero_hpc
#SBATCH --array=0-7
#SBATCH --output=SlurmOutput/ref_%a.txt

# ==========================================================================
# Generate high-quality reference data for the four 1D Euler benchmark cases
# with TWO shock-resolution methods, to compare the schemes and to serve as
# reference / training data for the alpha-policy network.
#
#   Method "pp"     : Persson-Peraire artificial viscosity on the RK4 DG solver
#                     (--solver rk4 --sensor PerssonPeraire)
#   Method "hybrid" : entropy-stable hybrid-DGSEM subcell FV blending
#                     (--solver hybrid_dgsem --alpha_max ...)
#
# 8 array tasks = 4 cases x 2 methods, indexed by SLURM_ARRAY_TASK_ID:
#
#   task | 0     1      2     3      4          5          6                 7
#   case | sod   sod    lax   lax    shu-osher  shu-osher  woodward-colella  woodward-colella
#   meth | pp    hybrid pp    hybrid pp         hybrid     pp                hybrid
#
# The automatic CFL time step (--dt -1) and the per-case final time (set in
# main.cpp) keep every run well-resolved and stable, so --T is left unset.
# ==========================================================================

# --- Per-case parameters (indexed by case = task/2) -----------------------
CASES=(sod   lax   shu-osher  woodward-colella)  # --case
PVAL=(6      6     6          3)                 # --P  polynomial order
NVAL=(200    200   400        512)               # --N  number of elements (refined for reference)
AMAX=(1.0    1.0   1.0        1.0)               # --alpha_max  (hybrid only)
CFL=(0.3     0.3   0.3        0.2)               # --cfl  Courant number (dt<0)

METHODS=(pp hybrid)

i=${SLURM_ARRAY_TASK_ID}
c=$((i / 2))          # case index  0..3
m=$((i % 2))          # method index 0..1

CASE=${CASES[$c]}
P=${PVAL[$c]}
N=${NVAL[$c]}
A=${AMAX[$c]}
C=${CFL[$c]}
METHOD=${METHODS[$m]}

TAG="${CASE}_${METHOD}"   # output/log basename
PTH="${CASE}/${METHOD}"

# --- Sanity check ---------------------------------------------------------
if [ ! -f "build/spectral" ]; then
    echo "Error: build/spectral not found. Build first: cmake -S . -B build && cmake --build build -j"
    exit 1
fi

mkdir -p SlurmOutput results

echo "================================================================================"
echo " Reference run [$i] : case=$CASE  method=$METHOD"
echo "   P=$P  N=$N  cfl=$C  dt=auto(CFL)  Q=0 (raw GLL nodes)"
echo "================================================================================"

# --- Run: dispatch on the resolution method -------------------------------
if [ "$METHOD" = "pp" ]; then
    # Persson-Peraire artificial-viscosity DG (RK4). Sensor/diffusion use the
    # default PP thresholds (trunc, s0, kappa, eps0) baked into main.cpp.
    ./build/spectral \
        --case "$CASE" \
        --solver "rk4" \
        --sensor "PerssonPeraire" \
        --P "$P" --N "$N" --Q 0 \
        --dt -1 --cfl "$C" \
        --output "$PTH" \
        --verbose 1 > "SlurmOutput/${TAG}.log" 2>&1
else
    # Entropy-stable hybrid-DGSEM with the built-in (Persson-Peraire) indicator
    # driving the FV blending factor alpha.
    ./build/spectral \
        --case "$CASE" \
        --solver "hybrid_dgsem" \
        --alpha_max "$A" \
        --P "$P" --N "$N" --Q 0 \
        --dt -1 --cfl "$C" \
        --output "$PTH" \
        --verbose 1 > "SlurmOutput/${TAG}.log" 2>&1
fi

status=$?
echo ""
if [ $status -eq 0 ]; then
    echo "DONE: $TAG  ->  results/${TAG}*   (log: SlurmOutput/${TAG}.log)"
else
    echo "FAILED: $TAG  (exit $status)  see SlurmOutput/${TAG}.log"
fi
exit $status
