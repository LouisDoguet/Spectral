#!/bin/bash
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --mem=16GB
#SBATCH --time=2:00:00
#SBATCH --job-name=HybridNN
#SBATCH --partition=short
#SBATCH --output=SlurmOutput/HybridNN.txt
#SBATCH --account=aero_hpc


# --------------------------------------------------------------------------
# Step 1: Train the alpha policy network (one-step reward RL).
#         The trainer runs a real hybrid-DGSEM Sod trajectory, sweeps the
#         candidate alpha grid, and learns the reward-optimal blending policy.
# --------------------------------------------------------------------------
echo ""
echo "STEP 1: Training hybrid-DGSEM alpha policy..."
if [ ! -f "build/train_hybrid_alpha" ]; then
    echo "Error: build/train_hybrid_alpha not found. Run: cd build && make"
    exit 1
fi

./build/train_hybrid_alpha "alpha_hybrid.nn" "0.005" > SlurmOutput/RL_training.log

# --------------------------------------------------------------------------
# Step 2: Run hybrid_dgsem with the learned alpha policy.
# --------------------------------------------------------------------------
echo ""
echo "STEP 2: Running hybrid_dgsem with NEURAL alpha policy..."
./build/spectral \
    --P 6 --N 50 --Q 0 --T 0.4 --dt 1e-4 \
    --solver "hybrid_dgsem" \
    --alpha_max 1. \
    --nn_model "alpha_hybrid.nn" \
    --output "HYBRID_NN" \
    --verbose 2 > SlurmOutput/hybrid_nn.log 2>&1 || true

# --------------------------------------------------------------------------
# Step 3: Run hybrid_dgsem with the baseline Persson-Peraire indicator.
# --------------------------------------------------------------------------
echo ""
echo "STEP 3: Running hybrid_dgsem with Persson-Peraire (baseline)..."
./build/spectral \
    --P 6 --N 50 --Q 0 --T 0.4 --dt 1e-4 \
    --solver "hybrid_dgsem" \
    --alpha_max 0.5 \
    --output "HYBRID_PP" \
    --verbose 1 > SlurmOutput/hybrid_pp.log 2>&1 || true

echo ""
echo "================================================================================"
echo "TEST COMPLETE"
echo "================================================================================"
echo ""
echo "  Model       : alpha_hybrid.nn"
echo "  Logs        : hybrid_nn.log (neural)   hybrid_pp.log (Persson-Peraire)"
echo "  Results     : results/HYBRID_NN*   results/HYBRID_PP*"
echo ""
echo "  Compare the two alpha fields and the resolved shock/contact in ParaView."
echo ""
